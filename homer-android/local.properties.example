## Copy this to local.properties (never commit local.properties)
sdk.dir=/path/to/Android/Sdk

## Cloud sync (talks to HOMER_BASE_URL/api — same login as the website)
SYNC_ENABLED=true
HOMER_SYNC_USERNAME=bogdan
HOMER_SYNC_PASSWORD=...

## AI gateway (OpenRouter)
OC_GATEWAY_URL=https://openrouter.ai/api/v1
OC_GATEWAY_TOKEN=sk-or-v1-...
OC_MODEL=inclusionai/ring-2.6-1t:free

## Homer website base URL
HOMER_BASE_URL=https://b4it.ro
